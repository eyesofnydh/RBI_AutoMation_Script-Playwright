# Copy to .env and adjust.

# Site under test
BASE_URL=https://stg-rbi.webc.in

# Optional HTTP basic auth (if staging is protected)
HTTP_USER=wacrebit
HTTP_PASS=W@cRb!486

# Crawler limits — the full RBI site is large, raise these for a complete run
MAX_PAGES=2000
CRAWL_CONCURRENCY=6
CRAWL_DELAY_MS=100
# Comma-separated regexes of paths to skip (matched against pathname)
CRAWL_EXCLUDE=^/hi/,/logout,/print/
# Max pages per URL template, e.g. /press-releases/* (~60,000 items). 0 = crawl everything (many hours)
MAX_PER_SECTION=100
# Also pull URLs from /sitemap.xml (true/false)
USE_SITEMAP=true

# Per-page checks
# Only run page checks on the first N crawled URLs (0 = all)
PAGE_CHECK_LIMIT=0
# Only run axe accessibility scans on the first N crawled URLs (0 = all)
A11Y_PAGE_LIMIT=200
# Only check the first N unique links (0 = all)
LINK_CHECK_LIMIT=0
# Check links on other domains too (rbi.org.in subdomains etc.)
CHECK_EXTERNAL_LINKS=true

# Auto-click tester: pages to exercise (0 = every crawled page) and max elements clicked per page
INTERACTION_PAGE_LIMIT=0
MAX_CLICKS_PER_PAGE=80

# Search term used by the search tests
SEARCH_TERM=repo rate
